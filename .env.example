# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Anthropic API key (server-side only; never exposed to the browser).
# Only required when AI_MODE=live.
ANTHROPIC_API_KEY=

# "mock" = fixture AI responses, $0 (default for development) · "live" = real Claude API calls
AI_MODE=mock

# Where the SQLite DB (app.db) and uploaded files (uploads/) live. Mount this as a volume in production.
DATA_DIR=./data

# Max size per uploaded file, in MB
MAX_UPLOAD_MB=50
